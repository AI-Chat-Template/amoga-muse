{
  "buildCommand": "npm run build:web -- --max-workers 1",
  "installCommand": "npm ci",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{dist/server/**,node_modules/@browserbasehq/stagehand/**}",
      "maxDuration": 300
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index" }
  ]
}
